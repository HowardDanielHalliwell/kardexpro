# Copia este archivo como .env y llena con tus credenciales reales de Supabase
# (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# ---- Solo backend (funciones /api de Vercel; nunca llegan al navegador) ----
# Supabase → Project Settings → API → service_role (¡mantenla secreta!)
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (tipo Web)
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI
# Debe coincidir EXACTAMENTE con un "Authorized redirect URI" del cliente OAuth
GOOGLE_REDIRECT_URI=https://TU-APP.vercel.app/api/classroom/callback
